# Command Code Provider API 키 (https://commandcode.ai/settings/keys 에서 발급)
# Go 플랜을 제외한 GOAT / Pro / Max / Provider 플랜에서 사용할 수 있습니다.
COMMANDCODE_API_KEY=user_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORT=3000

# --- 공개 배포용 무료 사용량 제한 ---------------------------------
# 단위(unit) 기준: 등장인물 추출 = 1, 인물 1명 판정 = 3
# 한 사람이 크레딧을 다 쓰지 못하도록 막는 장치입니다.
FREE_HOURLY_UNITS=60        # IP당 시간당
FREE_DAILY_UNITS=150        # IP당 일당
FREE_GLOBAL_DAILY_UNITS=1500  # 서비스 전체 일일 상한 (최악의 지출을 고정)
FREE_MAX_CONCURRENT=4       # 전체 동시 요청
FREE_MAX_CONCURRENT_PER_IP=2

# 리버스 프록시(Cloudflare, Nginx) 뒤에 있을 때만 1 로 설정합니다.
# 꺼져 있으면 X-Forwarded-For 를 무시합니다 (헤더 위조로 한도 우회 방지).
TRUST_PROXY=0

# 모델 응답 제한 시간(ms). 기본 120000
# ANALYZE_TIMEOUT_MS=120000
